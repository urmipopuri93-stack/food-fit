# Copy to chat-api/.env and fill in. Never commit .env.
# Without the three WATSONX_* values below, FitBasket still works: its built-in
# assistant answers from FoodFit's data, and /api/health lists what is missing.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Region endpoint, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Any chat model in your project that supports tool calling
WATSONX_MODEL_ID=mistralai/mistral-large
# Seconds to wait for watsonx before the built-in assistant takes over (5-120)
WATSONX_TIMEOUT_S=30
ALLOWED_ORIGINS=http://localhost:5173
CHAT_RATE_LIMIT_PER_MIN=30
# Food resources (Phase 2)
RESOURCE_RATE_LIMIT_PER_MIN=60
# Optional: point at a different normalized snapshot built by resources/build_snapshot.py
# RESOURCE_SNAPSHOT_PATH=resources/data/locationlist_snapshot.json

# Deployment (optional): serve the built frontend from this process.
# After `npm run build` in frontend/, set this to the absolute path of frontend/dist.
# FRONTEND_DIST=/path/to/food-fit-heatmap-work/frontend/dist

# Optional: tract GeoJSON used to recognise county names (defaults to ../frontend/public/data/texas_heatmap.geojson)
# TRACT_GEOJSON_PATH=/path/to/texas_heatmap.geojson
